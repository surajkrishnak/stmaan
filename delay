#include <Servo.h>

#define SERVO_PIN     PB7
#define RAIN_DO_PIN   PB6
#define DEBOUNCE_MS   100UL   // sensor reading must be steady this long
#define STEP_DELAY_MS 30UL    // wait between 1-degree steps (bigger = slower)

Servo myServo;

bool stableWet  = false;
bool lastRawWet = false;
unsigned long lastChangeTime = 0;

int currentAngle = 0;
int targetAngle  = 0;
unsigned long lastStepTime = 0;

void setup()
{
  pinMode(RAIN_DO_PIN, INPUT_PULLUP);

  myServo.attach(SERVO_PIN);
  myServo.write(currentAngle);

  lastRawWet = (digitalRead(RAIN_DO_PIN) == LOW);
}

void loop()
{
  // 1. Read sensor with debounce
  bool rawWet = (digitalRead(RAIN_DO_PIN) == LOW);

  if (rawWet != lastRawWet)
  {
    lastChangeTime = millis();
    lastRawWet = rawWet;
  }

  if ((millis() - lastChangeTime) >= DEBOUNCE_MS && rawWet != stableWet)
  {
    stableWet = rawWet;
    targetAngle = stableWet ? 90 : 0;
  }

  // 2. Move slowly toward the target, 1 degree at a time
  if (currentAngle != targetAngle && (millis() - lastStepTime) >= STEP_DELAY_MS)
  {
    lastStepTime = millis();
    currentAngle += (targetAngle > currentAngle) ? 1 : -1;
    myServo.write(currentAngle);
  }
}
